#include <windows.h>
#include "resource.h"

/////////////////////////////////////////////////////////////////////////////
//
// Version Information resources
//
VS_VERSION_INFO VERSIONINFO
    FILEVERSION VER_FILEVERSION
    PRODUCTVERSION VER_PRODUCTVERSION
    FILEOS          VOS_NT_WINDOWS32
    FILETYPE        VFT_DLL
    FILESUBTYPE     VFT2_UNKNOWN
    BEGIN
        BLOCK "StringFileInfo"
        BEGIN
            BLOCK "040904B0"
            BEGIN
#ifdef _WIN64
                VALUE "OriginalFilename", "gpxlister.wlx64"
#else
                VALUE "OriginalFilename", "gpxlister.wlx"
#endif
                VALUE "LegalCopyright", "Copyright \xA9 Nigurrath, 2026"
                VALUE "ProductVersion", VER_PRODUCTVERSION_STR
                VALUE "ProductName", "GPX/KML/FIT 2D/3D Viewer Lister Plugin"
                VALUE "InternalName", "GPXLister"
                VALUE "CompanyName", ""
                VALUE "Comments", "GPX/KML/FIT 2D/3D Tracks Viewer Lister Plugin for Total Commander"
                VALUE "FileVersion", VER_FILEVERSION_STR
                VALUE "FileDescription", "GPX/KML/FIT 2D/3D Viewer Lister Plugin for Total Commander"
            END
        END
        BLOCK "VarFileInfo"
        BEGIN
            VALUE "Translation", 0x0409, 1200
        END
    END

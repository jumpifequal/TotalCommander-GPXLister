[plugininstall]
type=wlx
name=GPXLister
title=GPXLister (GPX/FIT/KML/KMZ track viewer)
description=GPX/FIT/KML/KMZ viewer with flat 2D, perspective, real 3D terrain, profiles, summaries, and map tiles
file=GPXLister.wlx
defaultdir=GPXLister
defaultextension=gpx;fit;kml;kmz
defaultfilter=EXT="GPX" | EXT="FIT" | EXT="KML" | EXT="KMZ"
version=2.8.1
author=jumpifequal
homepage=https://github.com/jumpifequal/TotalCommander-GPXLister
notes=Requires Windows 10+. Keep the web folder beside the plugin for 3D and converters beside it for FIT,KML,KMZ support
